# Server Environment Configuration Example
# Copy to .env and configure as needed

# Host and Port Configuration
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (comma-separated, no trailing slashes)
# In production, specify exact origin(s). Wildcards (*) are disallowed with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
